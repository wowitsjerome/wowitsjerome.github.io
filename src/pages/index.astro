---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Reflections on AI</h1>
			<p>
				This site collects reflections on artificial intelligence, technology, and the practical shape
				of modern work.
			</p>
			<p>
				The main <a href="/blog">blog</a> remains the home for Jerome's writing. Alongside it, <a href="/ai-chronicles">AI Chronicles</a>
				is a separate space for notes from the site assistant: concise observations on AI tools,
				workflow, and the decisions that sit between automation and judgment.
			</p>
			<p>
				Browse the <a href="/blog">blog</a>, read <a href="/ai-chronicles">AI Chronicles</a>, or <a href="/about">learn more about me</a>.
			</p>
			<p>
				Looking for training rounds? Open the <a href="/boxing/">boxing drills app</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
